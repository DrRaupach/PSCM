<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>
         Planck Star Color Mapping (PSCM).
      </p>
   </description>
   <metadata id="20261122-PSCM-process" releaseDate="20261122">
      <title>Planck Star Color Mapping (PSCM) - v1.3</title>
      <description>
         <p>
                  This process performs mapping of narrow-band stars to RGB stars according to Planck&apos;s law in PixInsight.
               </p>
         <p>			   
                  It contains the smae algorithm as the script versions 1.2 and 1.3, but in form of a process.
               </p>
      </description>
   </metadata>
   <platform os="all" arch="noarch" version="1.9.3:1.9.3">
      <package fileName="PSCM_v120.zip" sha1="6cb2fd9d297e835d9b8ede1207dc56da13ec1fe9" type="script" releaseDate="202604191200000">
         <title>
               Planck Star Color Mapping (PSCM) - v1.2
            </title>
         <description>
            <p>
                  This script performs mapping of narrow-band stars to RGB stars according to Planck&apos;s law in PixInsight.
               </p>
            <p>			   
                  Modifications in Version 1.2 compared with 1.1.6:
               </p>
            <p>
                  - Improved background protection, requiring different settings: approx. old parameter divided by 4. The parameter/slider value is automatically recalculated if PSCM is started after updating from V1.1.6.
               </p>
         </description>
      </package>
   </platform>
   <platform os="all" arch="noarch" version="1.9.4:1.9.5">
      <package fileName="PSCM_v8engine_v130.zip" sha1="caa64b38523210d30d9e4c369c40810d12961724" type="script" releaseDate="20260906120000">
         <title>
               Planck Star Color Mapping (PSCM) - v1.3
            </title>
         <description>
            <p>
                  This script performs mapping of narrow-band stars to RGB stars according to Planck&apos;s law in PixInsight.
               </p>
            <p>			   
                  Modifications in Version 1.3 compared with 1.2:
               </p>
            <p>
                  - JavaScript V8 engine support.
               </p>
         </description>
      </package>
   </platform>
   <platform os="windows" arch="x64" version="1.9.6:1.9.9">
      <package fileName="PSCM_process_v130_windows.zip" sha1="318ad677e69eeda59965258d38c1b7a2019f865b" type="module" metadata="20261122-PSCM-process"/>
   </platform>
   <platform os="macosx" arch="arm64" version="1.9.6:1.9.9">
      <package fileName="PSCM_process_v130_macos.tar.gz" sha1="da16859d20ea841f08e4d5b08555e4f545df460f" type="module" metadata="20261122-PSCM-process"/>
   </platform>
