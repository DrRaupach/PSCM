   <platform os="all" arch="noarch" version="1.9.3:1.9.9">
      <package fileName="PSCM.zip" sha1="6cb2fd9d297e835d9b8ede1207dc56da13ec1fe9" type="script" releaseDate="20260419">
         <title>
            Planck Star Color Mapping (PSCM) - v1.2
         </title>
         <description>
            <p>
               This script performes mapping of narrow-band stars to RGB stars according to Planck&apos;s law in PixInsight.
            </p>
            <p>			   
			   Modifications in Version 1.2 compared with 1.1.6:<br/>
			   - Improved background protection, requiring different settings: approx. old parameter divided by 4. The parameter/slider value is automatically recalculated if PSCM is started after updating from V1.1.6.
            </p>
         </description>
      </package>
   </platform>
