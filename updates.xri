<xri version="1.0">
   <description>
      <p>
         Planck Star Color Mapping (PSCM).
      </p>
   </description>
   <repository>
      <platform os="all" arch="noarch" version="1.9.3:1.9.3">
         <package fileName="PSCM.zip" sha1="6cb2fd9d297e835d9b8ede1207dc56da13ec1fe9" type="module" releaseDate="20260419">
            <title>
               Planck Star Color Mapping (PSCM) - v1.2
            </title>
            <description>
               <p>
                  This script performs mapping of narrow-band stars to RGB stars according to Planck&apos;s law in PixInsight.
               </p>
               <p>			   
                  Modifications in Version 1.2 compared with 1.1.6:
               </p>
               <p>
                  - Improved background protection, requiring different settings: approx. old parameter divided by 4. The parameter/slider value is automatically recalculated if PSCM is started after updating from V1.1.6.
               </p>
            </description>
         </package>
      </platform>
      <platform os="all" arch="noarch" version="1.9.4:1.9.9">
         <package fileName="PSCM_v8engine.zip" sha1="caa64b38523210d30d9e4c369c40810d12961724" type="module" releaseDate="20260905">
            <title>
               Planck Star Color Mapping (PSCM) - v1.3
            </title>
            <description>
               <p>
                  This script performs mapping of narrow-band stars to RGB stars according to Planck&apos;s law in PixInsight.
               </p>
               <p>			   
                  Modifications in Version 1.3 compared with 1.2:
               </p>
               <p>
                  - JavaScript V8 engine support.
               </p>
            </description>
         </package>
      </platform>
   </repository>
</xri>
